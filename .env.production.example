# ═══════════════════════════════════════════════════════════════════
# Pincer — PRODUCTION configuration template (Sprint 7, T7.3)
# ═══════════════════════════════════════════════════════════════════
# Copy to .env.production, fill in secrets, then: scripts/deploy.sh
# DACH defaults are pre-filled (two-party consent, Europe/Berlin, 90d
# retention). `pincer doctor --production` refuses to deploy when the
# compliance block is weakened or a tunnel/localhost URL sneaks in.
#
# SECRETS: this file must be chmod 600, owned by the deploy user, and is
# git-ignored. Rotation procedures: docs/production-deployment.md §Secrets.

# ── Deployment ───────────────────────────────────────────
# Public hostnames (DNS A records → this host). Caddy fetches TLS certs.
PINCER_API_DOMAIN=api.example.com
PINCER_VOICE_DOMAIN=voice.example.com
PINCER_ACME_EMAIL=ops@example.com
# Image tag written by scripts/deploy.sh (git SHA); "prod" = latest deployed
PINCER_IMAGE_TAG=prod

# ── Core ─────────────────────────────────────────────────
PINCER_AGENT_NAME=Pincer
PINCER_DEFAULT_USER_ID=
PINCER_TIMEZONE=Europe/Berlin
PINCER_LOG_LEVEL=INFO
PINCER_DEBUG=false

# ── LLM providers ────────────────────────────────────────
PINCER_ANTHROPIC_API_KEY=
PINCER_OPENAI_API_KEY=
PINCER_DAILY_BUDGET_USD=25.0

# ── Environment (Sprint 8, T8.2) ─────────────────────────
# 'production' drops the localhost CORS origins and is a doctor gate.
PINCER_ENVIRONMENT=production

# ── API auth (required in production — doctor gate) ─────
# Both tokens are required and MUST DIFFER. An empty token means allow-all.
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
PINCER_DASHBOARD_TOKEN=
PINCER_WEB_CHAT_TOKEN=
# Brute-force guard: failures allowed per IP, then exponential lockout
PINCER_AUTH_MAX_FAILURES=10
PINCER_AUTH_LOCKOUT_SECONDS=300
# CORS: real origins only in production — never localhost
PINCER_DASHBOARD_URL=https://api.example.com
PINCER_WEB_CHAT_URL=
PINCER_CORS_EXTRA_ORIGINS=

# ── Voice (Twilio) ───────────────────────────────────────
PINCER_VOICE_ENABLED=true
PINCER_VOICE_OUTBOUND_ENABLED=true
PINCER_TWILIO_ACCOUNT_SID=
PINCER_TWILIO_AUTH_TOKEN=
PINCER_TWILIO_PHONE_NUMBER=
# MUST be the public voice hostname — no ngrok, no localhost (doctor gate)
PINCER_VOICE_WEBHOOK_BASE_URL=https://voice.example.com
PINCER_VOICE_ENGINE=conversation_relay
PINCER_VOICE_DEFAULT_LANGUAGE=de
PINCER_VOICE_SUPPORTED_LANGUAGES=en,de
PINCER_VOICE_DE_FORMALITY=sie
PINCER_VOICE_OUTBOUND_MAX_DAILY=25
PINCER_VOICE_MACHINE_DETECTION=true

# ── Voice security (Sprint 8 — doctor --production enforces these) ──
# Twilio signature validation on every webhook. NEVER set to false in prod.
PINCER_VOICE_WEBHOOK_VALIDATE=true
# Signed token required on the ConversationRelay / Media Streams WS upgrade.
PINCER_VOICE_WS_AUTH_REQUIRED=true
# Replay window for signed requests (seconds)
PINCER_VOICE_SIGNATURE_MAX_AGE_S=300

# ── Outbound abuse prevention (Sprint 8, T8.3) ───────────
# Hard cap across ALL users and channels (0 = no global cap)
PINCER_VOICE_DAILY_CALL_LIMIT=20
# Minutes one number is off-limits after a call (retries share this budget)
PINCER_VOICE_TARGET_COOLDOWN_MIN=60
# No outbound calls in this local-time window (§7 UWG). Empty = disabled.
PINCER_VOICE_QUIET_HOURS=20:00-08:00
# Comma-separated user IDs exempt from quiet hours (emergency use only)
PINCER_VOICE_QUIET_HOURS_OVERRIDE_USERS=

# ── Observability & alerting (Sprint 9) ──────────────────
# doctor: CRITICAL when alerts are enabled with no recipient at all.
PINCER_TELEMETRY_DSN=
PINCER_OPS_ALERTS_ENABLED=true
PINCER_OPS_USER_ID=
PINCER_OPS_CHANNEL=telegram
PINCER_OPS_ALERT_EMAIL=
PINCER_OPS_ALERT_SCAN_INTERVAL_MIN=5
PINCER_OPS_DIGEST_CRON=0 9 * * 1

# Synthetic canary — a staging responder you own, never a customer number.
PINCER_VOICE_CANARY_ENABLED=true
PINCER_VOICE_CANARY_NUMBER=
PINCER_VOICE_CANARY_CRON=0 */6 * * *
# Without this the overnight canary runs are skipped by quiet hours.
PINCER_VOICE_QUIET_HOURS_OVERRIDE_USERS=pincer-canary

# Real account rates, not the defaults — see docs/operations/runbook.md#cost-spike
PINCER_PRICE_TWILIO_OUTBOUND_PER_MIN=0.10
PINCER_PRICE_CONVERSATIONRELAY_PER_MIN=0.06
PINCER_PRICE_ELEVENLABS_PER_1K_CHARS=0.05

# ── DACH compliance (Sprint 0 — doctor --production enforces these) ──
PINCER_VOICE_CONSENT_MODE=two_party
PINCER_VOICE_TIMEZONE=Europe/Berlin
PINCER_VOICE_TRANSCRIPT_RETENTION_DAYS=90
PINCER_VOICE_RECORDING_ENABLED=false

# ── Voice providers (EU endpoints where available) ───────
PINCER_ELEVENLABS_API_KEY=
PINCER_ELEVENLABS_VOICE_ID=
PINCER_ELEVENLABS_VOICE_ID_DE=
PINCER_DEEPGRAM_API_KEY=

# ── Appointment scheduling (Sprint 6) ────────────────────
PINCER_BUSINESS_HOURS=09:00-17:00
PINCER_BUSINESS_DAYS=mon,tue,wed,thu,fri
PINCER_SLOT_BUFFER_MIN=15
PINCER_SCHEDULING_CALENDAR_ID=primary
PINCER_VOICE_RETRY_ATTEMPTS=2
PINCER_VOICE_RETRY_DELAY_MIN=30

# ── Channels (enable per customer) ───────────────────────
PINCER_TELEGRAM_BOT_TOKEN=
PINCER_TELEGRAM_ALLOWED_USERS=
PINCER_WHATSAPP_ENABLED=false
PINCER_SIGNAL_ENABLED=false

# ── Backups (scripts/backup-db.sh) ───────────────────────
# Passphrase for the encrypted backup archive (gpg symmetric)
PINCER_BACKUP_PASSPHRASE=
# Optional S3-compatible EU bucket via rclone remote name (empty = local only)
PINCER_BACKUP_RCLONE_REMOTE=
PINCER_BACKUP_RETENTION_DAYS=30

# ── Explicitly ABSENT in production (doctor gate) ────────
# PINCER_NGROK_AUTHTOKEN must NOT be set here.
