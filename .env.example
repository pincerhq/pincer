# ═══════════════════════════════════════════════
# 🦜 Pincer — Environment Variables
# ═══════════════════════════════════════════════
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── Generic ──────────────────────────────────
# TZ=UTC                                # uncomment this if you want to change timezone
PINCER_BASE_URL=http://localhost:8080   # highly required if application require operate with webhooks, send email or use letsencrypt certificates

# ── LLM Provider ─────────────────────────────
# Well-known providers ("openai"/"anthropic") need only an API key — the base URL
# is built in. Any other provider name (grok, ollama, a proxy, …) is a "compatible"
# endpoint: name it via *_COMPATIBLE_PROVIDER and point it at a base URL below.
PINCER_DEFAULT_PROVIDER=anthropic       # "openai" | "anthropic" | or a *_COMPATIBLE_PROVIDER
PINCER_FALLBACK_PROVIDERS=              # Up to 3 comma-separated provider names for random failover
PINCER_ANTHROPIC_API_KEY=sk-ant-...     # Required for the well-known "anthropic" provider
PINCER_OPENAI_API_KEY=sk-proj-...       # Required for the well-known "openai" provider (+ voice transcription)
PINCER_DEFAULT_MODEL=claude-sonnet-4-5-20250929   # Model for the PRIMARY provider
PINCER_MAX_TOKENS=4096
PINCER_TEMPERATURE=0.7
# Each provider has its OWN model so failover targets the right one (empty → default_model):
PINCER_ANTHROPIC_MODEL=                 # model when "anthropic" is primary/failover
PINCER_OPENAI_MODEL=                    # model when "openai" is primary/failover (e.g. gpt-4o)

# ── Compatible endpoints (Grok, Ollama, local proxies, gateways) ────────────────
# Give each endpoint a free-form name, then reference it in DEFAULT/FALLBACK above.
# Key is optional (e.g. Ollama needs none). Set the endpoint's model on its own
# *_COMPATIBLE_MODEL var (empty → falls back to PINCER_DEFAULT_MODEL).
#
# Grok example:
#   PINCER_DEFAULT_PROVIDER=grok
#   PINCER_OPENAI_COMPATIBLE_PROVIDER=grok
#   PINCER_OPENAI_COMPATIBLE_BASE_URL=https://api.x.ai/v1
#   PINCER_OPENAI_COMPATIBLE_API_KEY=xai-...
#   PINCER_OPENAI_COMPATIBLE_MODEL=grok-3
#
# Ollama example (no key):
#   PINCER_DEFAULT_PROVIDER=ollama
#   PINCER_OPENAI_COMPATIBLE_PROVIDER=ollama
#   PINCER_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#   PINCER_OPENAI_COMPATIBLE_MODEL=llama3.2
#
# Failover example — Anthropic primary, Ollama failover, each with its own model:
#   PINCER_DEFAULT_PROVIDER=anthropic
#   PINCER_FALLBACK_PROVIDERS=ollama
#   PINCER_DEFAULT_MODEL=claude-sonnet-4-5-20250929
#   PINCER_OPENAI_COMPATIBLE_PROVIDER=ollama
#   PINCER_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#   PINCER_OPENAI_COMPATIBLE_MODEL=llama3.2
PINCER_OPENAI_COMPATIBLE_PROVIDER=
PINCER_OPENAI_COMPATIBLE_BASE_URL=
PINCER_OPENAI_COMPATIBLE_API_KEY=
PINCER_OPENAI_COMPATIBLE_MODEL=
# Anthropic-wire endpoint (proxy/gateway):
PINCER_ANTHROPIC_COMPATIBLE_PROVIDER=
PINCER_ANTHROPIC_COMPATIBLE_BASE_URL=
PINCER_ANTHROPIC_COMPATIBLE_API_KEY=
PINCER_ANTHROPIC_COMPATIBLE_MODEL=

# ── Telegram ─────────────────────────────────
PINCER_TELEGRAM_BOT_TOKEN=              # From @BotFather
PINCER_TELEGRAM_ALLOWED_USERS=          # Comma-separated user IDs (empty = allow all)

# ── Agent ────────────────────────────────────
PINCER_AGENT_NAME=Pincer
PINCER_MAX_TOOL_ITERATIONS=10
PINCER_MAX_SESSION_MESSAGES=50
PINCER_DAILY_BUDGET_USD=5.0

# ── Search ───────────────────────────────────
PINCER_TAVILY_API_KEY=tvly-...          # Optional: Tavily search

# ── Shell ────────────────────────────────────
PINCER_SHELL_ENABLED=true
PINCER_SHELL_TIMEOUT=30
PINCER_SHELL_REQUIRE_APPROVAL=true

# ── Memory ───────────────────────────────────
PINCER_MEMORY_ENABLED=true
PINCER_MEMORY_BACKEND=sqlite
# PINCER_MEMORY_BACKEND=mcp
# PINCER_MEMORY_MCP_SERVER=sqlite-vec-memory # Optional: change name regarding mcp servers config. works only if PINCER_MEMORY_BACKEND=mcp
PINCER_SUMMARY_PROVIDER=                        # Which pool provider summarizes (defaults to the primary)
PINCER_SUMMARY_MODEL=claude-haiku-4-5-20251001  # Model used for summarization on that provider
PINCER_SUMMARY_THRESHOLD=20

# ── Storage & Logging ────────────────────────
# PINCER_DATA_DIR=~/.pincer             # Default
# PINCER_SRC_DIR=                       # Repo root for MCP server paths. Defaults to $PWD (set if running pincer outside the project root). Docker default: /app via WORKDIR.
PINCER_LOG_LEVEL=INFO

# ═══════════════════════════════════════════════
# Sprint 3: WhatsApp + Proactive Agent
# ═══════════════════════════════════════════════

# ── WhatsApp ─────────────────────────────────
PINCER_WHATSAPP_ENABLED=false
PINCER_WHATSAPP_SELF_CHAT_ONLY=true     # true = only self-chat + group mentions; false = allow DMs from allowlist
PINCER_WHATSAPP_DM_ALLOWLIST=           # Comma-separated; empty = self-chat and group mentions only
PINCER_WHATSAPP_GROUP_TRIGGER=pincer

# ── Cross-Channel Identity ───────────────────
# Format: telegram:TELEGRAM_USER_ID=whatsapp:PHONE_WITHOUT_PLUS
PINCER_IDENTITY_MAP=
PINCER_DEFAULT_USER_ID=

# ── Email (Gmail: use App Password) ──────────
PINCER_EMAIL_IMAP_HOST=imap.gmail.com
PINCER_EMAIL_IMAP_PORT=993
PINCER_EMAIL_SMTP_HOST=smtp.gmail.com
PINCER_EMAIL_SMTP_PORT=587
PINCER_EMAIL_USERNAME=
PINCER_EMAIL_PASSWORD=
PINCER_EMAIL_FROM=

# ── Google Calendar ──────────────────────────
# 1. Create OAuth 2.0 Client ID in Google Cloud Console
# 2. Download JSON -> save as data/google_credentials.json
# 3. On first calendar_today() call, browser opens for consent
# 4. Token auto-saved to data/google_token.json

# ── Proactive Agent ──────────────────────────
PINCER_OPENWEATHERMAP_API_KEY=
PINCER_NEWSAPI_KEY=
PINCER_BRIEFING_TIME=07:00
PINCER_BRIEFING_TIMEZONE=Europe/Berlin
PINCER_TIMEZONE=Europe/Berlin

# ── Webhooks ─────────────────────────────────
PINCER_WEBHOOK_PORT=8765
PINCER_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════
# Sprint 4: Discord + Skills
# ═══════════════════════════════════════════════

# ── Discord ──────────────────────────────────
PINCER_DISCORD_BOT_TOKEN=

# ── Skills ───────────────────────────────────
# User skills directory (default: ~/.pincer/skills/)
# PINCER_SKILLS_DIR=~/.pincer/skills

# ═══════════════════════════════════════════════
# Sprint 5: Security + API + Docker
# ═══════════════════════════════════════════════

# ── Dashboard / API ─────────────────────────
PINCER_DASHBOARD_TOKEN=                # Bearer token for API auth (generate: python -c "import secrets; print(secrets.token_hex(32))")
PINCER_DASHBOARD_HOST=127.0.0.1        # Bind host (127.0.0.1 = local only, 0.0.0.0 = network)
PINCER_DASHBOARD_PORT=8080             # API server port
# PINCER_DASHBOARD_DIST=/app/dashboard/dist  # Override dashboard path (Docker sets this automatically)

# ── Security ────────────────────────────────
PINCER_AUDIT_DISABLED=false            # Set true to disable audit logging
PINCER_RATE_MESSAGES_PER_MIN=30        # Per-user message rate limit
PINCER_RATE_TOOLS_PER_MIN=20           # Per-user tool call rate limit
PINCER_MAX_CONCURRENT_LLM=5            # Max concurrent LLM requests
# PINCER_DEBUG=false                   # Enable debug mode (exposes /api/docs)

# ═══════════════════════════════════════════════
# Sprint 7: Voice Calling
# ═══════════════════════════════════════════════

# ── Twilio ───────────────────────────────────
PINCER_VOICE_ENABLED=false
PINCER_TWILIO_ACCOUNT_SID=             # Twilio Account SID (ACxxxxxxxx)
PINCER_TWILIO_AUTH_TOKEN=              # Twilio Auth Token
PINCER_TWILIO_PHONE_NUMBER=            # Twilio phone number (E.164: +1234567890)
PINCER_VOICE_WEBHOOK_BASE_URL=         # Public HTTPS URL for Twilio webhooks

# ── Voice Engine ─────────────────────────────
PINCER_VOICE_ENGINE=conversation_relay # conversation_relay (Phase 1) | media_streams (Phase 2)
PINCER_VOICE_LANGUAGE=en-US            # Primary STT language
PINCER_VOICE_MAX_CALL_DURATION=600     # Max call length in seconds
PINCER_VOICE_MAX_HOLD_TIME=300         # Max IVR hold time in seconds

# ── STT/TTS Providers (Phase 2: Media Streams) ──
PINCER_DEEPGRAM_API_KEY=               # Deepgram streaming STT key
PINCER_ELEVENLABS_API_KEY=             # ElevenLabs streaming TTS key
PINCER_ELEVENLABS_VOICE_ID=            # Optional: specific voice ID

# ── Outbound Calling ─────────────────────────
PINCER_VOICE_OUTBOUND_ENABLED=false    # Enable agent-initiated calls
PINCER_VOICE_OUTBOUND_MAX_DAILY=10     # Max outbound calls per day

# ── Safety & Compliance ──────────────────────
PINCER_VOICE_RECORDING_ENABLED=false   # Enable call recording
PINCER_VOICE_CONSENT_MODE=one_party    # one_party | two_party | none
PINCER_VOICE_ALLOWED_CALLERS=*         # Comma-separated E.164 numbers (* = all)

# ═══════════════════════════════════════════════
# Sprint 7.5: Signal Messenger
# ═══════════════════════════════════════════════

# ── Signal ───────────────────────────────────
PINCER_SIGNAL_ENABLED=false
# SIGNAL_API_IMAGE=bbernhard/signal-cli-rest-api:latest-dev   # Docker image (default: latest-dev)
PINCER_SIGNAL_API_URL=http://signal-api:8080     # signal-cli-rest-api (inter-container)
PINCER_SIGNAL_PAIR_URL=http://127.0.0.1:8081     # URL for pincer signal pair (host-facing)
PINCER_SIGNAL_PHONE_NUMBER=                      # Registered phone (E.164: +1234567890)
PINCER_SIGNAL_ALLOWLIST=                         # Comma-separated allowed DM numbers; empty = allow all
PINCER_SIGNAL_GROUP_REPLY=mention_only           # mention_only | all | disabled
PINCER_SIGNAL_RECEIVE_MODE=websocket             # websocket | poll
PINCER_SIGNAL_POLL_INTERVAL=2                    # Poll interval in seconds (poll mode only)
# Cross-channel identity: signal:+491234567890
# PINCER_IDENTITY_MAP=telegram:12345=signal:+491234567890

# ═══════════════════════════════════════════════
# Slack Channel (Socket Mode)
# ═══════════════════════════════════════════════

# ── Slack Channel ────────────────────────────
# PINCER_SLACK_BOT_TOKEN=xoxb-...            # Bot User OAuth Token (from OAuth & Permissions)
# PINCER_SLACK_APP_TOKEN=xapp-...            # App-Level Token with scope: connections:write (for Socket Mode)
# PINCER_SLACK_USER_ALLOWLIST=               # Comma-separated Slack user IDs allowed to use the bot; empty = allow all
# Cross-channel identity: slack:U12345678
# PINCER_IDENTITY_MAP=telegram:12345=slack:U12345678

# ═══════════════════════════════════════════════
# Microsoft Teams Channel (inbound HTTP push via Azure Bot)
# ═══════════════════════════════════════════════
# Register an Azure Bot, enable the Teams channel, set the messaging endpoint to
# https://<public-host>/api/messages, and note the App ID + App Password.
# See docs/teams-setup.md for the full walkthrough (incl. ngrok for local dev).
# PINCER_TEAMS_APP_ID=                       # Azure Bot / App Registration App (client) ID
# PINCER_TEAMS_APP_PASSWORD=                 # App Password (client secret)
# PINCER_TEAMS_PORT=3978                     # Local port for the bot's HTTP server
# PINCER_TEAMS_USER_ALLOWLIST=               # Comma-separated AAD object IDs / UPNs; empty = allow all

# ═══════════════════════════════════════════════
# Web Chat (browser widget)
# ═══════════════════════════════════════════════

# Optional dedicated bearer token for the chat widget. If unset, the widget
# can authenticate with PINCER_DASHBOARD_TOKEN. If both are unset, the API
# is open (dev/tests only).
# PINCER_WEB_CHAT_TOKEN=

# Origin of the frontend app, added to CORS allow_origins (e.g. https://3days.ai).
# PINCER_WEB_CHAT_URL=

# ═══════════════════════════════════════════════
# Microsoft 365 MCP Server
# ═══════════════════════════════════════════════

# Set these before running 'ms365-mcp-setup' to authenticate via device code flow.
# PINCER_MS365_CLIENT_ID=              # Azure App Application (client) ID
# PINCER_MS365_TENANT_ID=consumers     # "consumers" for personal accounts, "common", or your org tenant GUID
# PINCER_MS365_CLIENT_SECRET=          # Reserved (not used by device code flow)
