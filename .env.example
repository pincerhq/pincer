# ═══════════════════════════════════════════════
# 🦜 Pincer — Environment Variables
# ═══════════════════════════════════════════════
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── Generic ──────────────────────────────────
# uncomment this if you want to change timezone
# TZ=UTC
# highly required if application require operate with webhooks, send email or use letsencrypt certificates
PINCER_BASE_URL=http://localhost:8080

# ── LLM Provider ─────────────────────────────
# Well-known providers ("openai"/"anthropic") need only an API key — the base URL
# is built in. Any other provider name (grok, ollama, a proxy, …) is a "compatible"
# endpoint: name it via *_COMPATIBLE_PROVIDER and point it at a base URL below.
# "openai" | "anthropic" | or a *_COMPATIBLE_PROVIDER
PINCER_DEFAULT_PROVIDER=anthropic
# Up to 3 comma-separated provider names for random failover
PINCER_FALLBACK_PROVIDERS=
# Required for the well-known "anthropic" provider
PINCER_ANTHROPIC_API_KEY=sk-ant-...
# Required for the well-known "openai" provider (+ voice transcription)
PINCER_OPENAI_API_KEY=sk-proj-...
# Model for the PRIMARY provider
PINCER_DEFAULT_MODEL=claude-sonnet-4-5-20250929
PINCER_MAX_TOKENS=4096
PINCER_TEMPERATURE=0.7
# Each provider has its OWN model so failover targets the right one (empty → default_model):
# model when "anthropic" is primary/failover
PINCER_ANTHROPIC_MODEL=
# model when "openai" is primary/failover (e.g. gpt-4o)
PINCER_OPENAI_MODEL=

# ── Compatible endpoints (Grok, Ollama, local proxies, gateways) ────────────────
# Give each endpoint a free-form name, then reference it in DEFAULT/FALLBACK above.
# Key is optional (e.g. Ollama needs none). Set the endpoint's model on its own
# *_COMPATIBLE_MODEL var (empty → falls back to PINCER_DEFAULT_MODEL).
#
# Grok example:
#   PINCER_DEFAULT_PROVIDER=grok
#   PINCER_OPENAI_COMPATIBLE_PROVIDER=grok
#   PINCER_OPENAI_COMPATIBLE_BASE_URL=https://api.x.ai/v1
#   PINCER_OPENAI_COMPATIBLE_API_KEY=xai-...
#   PINCER_OPENAI_COMPATIBLE_MODEL=grok-3
#
# Ollama example (no key):
#   PINCER_DEFAULT_PROVIDER=ollama
#   PINCER_OPENAI_COMPATIBLE_PROVIDER=ollama
#   PINCER_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#   PINCER_OPENAI_COMPATIBLE_MODEL=llama3.2
#
# Failover example — Anthropic primary, Ollama failover, each with its own model:
#   PINCER_DEFAULT_PROVIDER=anthropic
#   PINCER_FALLBACK_PROVIDERS=ollama
#   PINCER_DEFAULT_MODEL=claude-sonnet-4-5-20250929
#   PINCER_OPENAI_COMPATIBLE_PROVIDER=ollama
#   PINCER_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#   PINCER_OPENAI_COMPATIBLE_MODEL=llama3.2
PINCER_OPENAI_COMPATIBLE_PROVIDER=
PINCER_OPENAI_COMPATIBLE_BASE_URL=
PINCER_OPENAI_COMPATIBLE_API_KEY=
PINCER_OPENAI_COMPATIBLE_MODEL=
# Anthropic-wire endpoint (proxy/gateway):
PINCER_ANTHROPIC_COMPATIBLE_PROVIDER=
PINCER_ANTHROPIC_COMPATIBLE_BASE_URL=
PINCER_ANTHROPIC_COMPATIBLE_API_KEY=
PINCER_ANTHROPIC_COMPATIBLE_MODEL=

# ── Telegram ─────────────────────────────────
# From @BotFather
PINCER_TELEGRAM_BOT_TOKEN=
# Comma-separated user IDs (empty = allow all)
PINCER_TELEGRAM_ALLOWED_USERS=

# ── Agent ────────────────────────────────────
PINCER_AGENT_NAME=Pincer
PINCER_MAX_TOOL_ITERATIONS=10
PINCER_MAX_SESSION_MESSAGES=50
PINCER_DAILY_BUDGET_USD=5.0

# ── Search ───────────────────────────────────
# Optional: Tavily search
PINCER_TAVILY_API_KEY=tvly-...

# ── Shell ────────────────────────────────────
PINCER_SHELL_ENABLED=true
PINCER_SHELL_TIMEOUT=30
PINCER_SHELL_REQUIRE_APPROVAL=true

# ── Memory ───────────────────────────────────
PINCER_MEMORY_ENABLED=true
PINCER_MEMORY_BACKEND=sqlite
# PINCER_MEMORY_BACKEND=mcp
# PINCER_MEMORY_MCP_SERVER=sqlite-vec-memory # Optional: change name regarding mcp servers config. works only if PINCER_MEMORY_BACKEND=mcp
# Which pool provider summarizes (defaults to the primary)
PINCER_SUMMARY_PROVIDER=
# Model used for summarization on that provider
PINCER_SUMMARY_MODEL=claude-haiku-4-5-20251001
PINCER_SUMMARY_THRESHOLD=20

# ── Storage & Logging ────────────────────────
# Default dir
# PINCER_DATA_DIR=~/.pincer
# Repo root for MCP server paths. Defaults to $PWD (set if running pincer outside the project root). Docker default: /app via WORKDIR.
# PINCER_SRC_DIR=
PINCER_LOG_LEVEL=INFO

# ── Background Task Execution (repid) ───────────────────
# Broker for scheduled/background task execution. 'memory' (default) runs
# everything in-process — zero infra, but can't be shared across processes.
# 'redis' is required for `pincer run tasks` (standalone worker, horizontal scaling).
#PINCER_TASK_BROKER=redis
# Broker connection URL, required when PINCER_TASK_BROKER=redis
#PINCER_TASK_BROKER_URL="redis://redis:6379/0"

# ═══════════════════════════════════════════════
# Sprint 3: WhatsApp + Proactive Agent
# ═══════════════════════════════════════════════

# ── WhatsApp ─────────────────────────────────
PINCER_WHATSAPP_ENABLED=false
# true = only self-chat + group mentions; false = allow DMs from allowlist
PINCER_WHATSAPP_SELF_CHAT_ONLY=true
# Comma-separated; empty = self-chat and group mentions only
PINCER_WHATSAPP_DM_ALLOWLIST=
PINCER_WHATSAPP_GROUP_TRIGGER=pincer

# ── Cross-Channel Identity ───────────────────
# Format: pincer_user_id1@telegram:TELEGRAM_USER_ID=whatsapp:PHONE_WITHOUT_PLUS[,pincer_user_id2@telegram:TELEGRAM_USER_ID=whatsapp:PHONE_WITHOUT_PLUS, ...]
PINCER_IDENTITY_MAP=
PINCER_DEFAULT_USER_ID=

# ── Email (Gmail: use App Password) ──────────
PINCER_EMAIL_IMAP_HOST=imap.gmail.com
PINCER_EMAIL_IMAP_PORT=993
PINCER_EMAIL_SMTP_HOST=smtp.gmail.com
PINCER_EMAIL_SMTP_PORT=587
PINCER_EMAIL_USERNAME=
PINCER_EMAIL_PASSWORD=
PINCER_EMAIL_FROM=

# ── Google Calendar ──────────────────────────
# 1. Create OAuth 2.0 Client ID in Google Cloud Console
# 2. Download JSON -> save as data/google_credentials.json
# 3. On first calendar_today() call, browser opens for consent
# 4. Token auto-saved to data/google_token.json

# ── Proactive Agent ──────────────────────────
PINCER_BRIEFING_TIME=07:00
PINCER_BRIEFING_TIMEZONE=Europe/Berlin
PINCER_TIMEZONE=Europe/Berlin

# ── Webhooks ─────────────────────────────────
PINCER_WEBHOOK_PORT=8765
PINCER_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════
# Sprint 4: Discord + Skills
# ═══════════════════════════════════════════════

# ── Discord ──────────────────────────────────
PINCER_DISCORD_BOT_TOKEN=

# ── Skills ───────────────────────────────────
# User skills directory (default: ~/.pincer/skills/)
# PINCER_SKILLS_DIR=~/.pincer/skills

# ═══════════════════════════════════════════════
# Sprint 5: Security + API + Docker
# ═══════════════════════════════════════════════

# ── Dashboard / API ─────────────────────────
# Bearer token for API auth (generate: python -c "import secrets; print(secrets.token_hex(32))")
PINCER_DASHBOARD_TOKEN=
# Bind host (127.0.0.1 = local only, 0.0.0.0 = network)
PINCER_DASHBOARD_HOST=127.0.0.1
# API server port
PINCER_DASHBOARD_PORT=8080
# Override dashboard path (Docker sets this automatically)
# PINCER_DASHBOARD_DIST=/app/dashboard/dist

# ── Security ────────────────────────────────
# Set true to disable audit logging
PINCER_AUDIT_DISABLED=false
# Per-user message rate limit
PINCER_RATE_MESSAGES_PER_MIN=30
# Per-user tool call rate limit
PINCER_RATE_TOOLS_PER_MIN=20
# Max concurrent LLM requests
PINCER_MAX_CONCURRENT_LLM=5
# Enable debug mode (exposes /api/docs)
# PINCER_DEBUG=false

# ═══════════════════════════════════════════════
# Sprint 7: Voice Calling
# ═══════════════════════════════════════════════

# ── Twilio ───────────────────────────────────
PINCER_VOICE_ENABLED=false
# Twilio Account SID (ACxxxxxxxx)
PINCER_TWILIO_ACCOUNT_SID=
# Twilio Auth Token
PINCER_TWILIO_AUTH_TOKEN=
# Twilio phone number (E.164: +1234567890)
PINCER_TWILIO_PHONE_NUMBER=
# Public HTTPS URL for Twilio webhooks
PINCER_VOICE_WEBHOOK_BASE_URL=

# ── Voice Engine ─────────────────────────────
# conversation_relay (Phase 1) | media_streams (Phase 2)
PINCER_VOICE_ENGINE=conversation_relay
# Primary STT language (legacy fallback)
PINCER_VOICE_LANGUAGE=en-US
# ── Call Language (Sprint 2) ─────────────────
# Language is per-call: make_phone_call(..., language="de"). These are the defaults.
# Fallback call language when none is given or inferable
PINCER_VOICE_DEFAULT_LANGUAGE=en
# Languages accepted for the per-call parameter
PINCER_VOICE_SUPPORTED_LANGUAGES=en,de,uk
# German register: sie (formal, default) | du (informal)
PINCER_VOICE_DE_FORMALITY=sie
# Max call length in seconds
PINCER_VOICE_MAX_CALL_DURATION=600
# Max IVR hold time in seconds
PINCER_VOICE_MAX_HOLD_TIME=300

# ── STT/TTS Providers (Phase 2: Media Streams) ──
# Deepgram streaming STT key
PINCER_DEEPGRAM_API_KEY=
# ElevenLabs streaming TTS key
PINCER_ELEVENLABS_API_KEY=
# Optional: specific voice ID (fallback for all languages)
PINCER_ELEVENLABS_VOICE_ID=
# Optional: per-language voices (fall back to PINCER_ELEVENLABS_VOICE_ID)
PINCER_ELEVENLABS_VOICE_ID_EN=
PINCER_ELEVENLABS_VOICE_ID_DE=
PINCER_ELEVENLABS_VOICE_ID_UK=
# ── ElevenLabs tuning (Sprint 4) ─────────────
# TTS model — eleven_flash_v2_5 is multilingual (incl. German) and low-latency
PINCER_ELEVENLABS_MODEL=eleven_flash_v2_5
# Voice settings (stability/similarity 0.0-1.0, speed 0.7-1.2, style 0.0-1.0)
PINCER_ELEVENLABS_STABILITY=0.5
PINCER_ELEVENLABS_SIMILARITY=0.75
PINCER_ELEVENLABS_SPEED=1.0
PINCER_ELEVENLABS_STYLE=0.0
# Media Streams audio: ulaw_8000 (native telephony, default) | pcm_16000 (legacy fallback)
PINCER_ELEVENLABS_OUTPUT_FORMAT=ulaw_8000
# ConversationRelay TTS provider: google | amazon | elevenlabs
# (empty = auto: elevenlabs when an ElevenLabs voice is configured, else google)
PINCER_CR_TTS_PROVIDER=

# ── Outbound Calling ─────────────────────────
# Enable agent-initiated calls
PINCER_VOICE_OUTBOUND_ENABLED=false
# Max outbound calls per day
PINCER_VOICE_OUTBOUND_MAX_DAILY=10
# Automatic redial attempts after a failed call (0 = none; reserved for later sprints)
PINCER_VOICE_RETRY_ATTEMPTS=0
# Answering Machine Detection: voicemail is detected and reported, not conversed with
PINCER_VOICE_MACHINE_DETECTION=true
# Below this STT confidence the agent asks the caller to repeat instead of guessing
PINCER_VOICE_STT_MIN_CONFIDENCE=0.55
# Auto-execute post-call follow-up suggestions without a user turn
# (reserved; this build always proposes and waits for approval)
PINCER_VOICE_AUTO_FOLLOWUP=false
# ── Safety & Compliance ──────────────────────
# Enable call recording
PINCER_VOICE_RECORDING_ENABLED=false
# one_party | two_party | none
PINCER_VOICE_CONSENT_MODE=one_party
# Comma-separated E.164 numbers (* = all)
PINCER_VOICE_ALLOWED_CALLERS=*
# Language of the consent/AI-disclosure announcement (ISO 639-1, e.g. de);
# empty = follow call language, fallback en
PINCER_VOICE_CONSENT_LANGUAGE=
# ── Call Introduction ────────────────────────
# Spoken at call start, before the consent announcement, e.g.
# "This is Pincer, the AI assistant from 3days.ai and personal AI assistant of Volodymyr Pugachov."
# Name the assistant introduces itself with (empty = skip introduction)
PINCER_VOICE_ASSISTANT_NAME=Pincer
# Organization named in the introduction (empty = omitted)
PINCER_VOICE_ASSISTANT_ORG=3days.ai
# Person the assistant serves — "personal AI assistant of …" (empty = omitted)
PINCER_VOICE_ASSISTANT_OWNER=
# Verbatim override of the whole introduction sentence
PINCER_VOICE_INTRO_TEXT=
# Days to keep call transcripts/actions (GDPR storage limitation); 0 = keep forever
PINCER_VOICE_TRANSCRIPT_RETENTION_DAYS=90
# IANA timezone for voice-facing time rendering; empty = PINCER_TIMEZONE
PINCER_VOICE_TIMEZONE=

# ── Sprint 0: Recommended DACH (DE/AT/CH) settings ──
# Germany (§201 StGB) and Switzerland (Art. 179ter StGB) require all-party
# consent for call recording. Recommended defaults for a +49/+43/+41 number:
# PINCER_VOICE_CONSENT_MODE=two_party
# PINCER_VOICE_CONSENT_LANGUAGE=de
# PINCER_VOICE_LANGUAGE=de-DE
# PINCER_VOICE_TIMEZONE=Europe/Berlin
# PINCER_VOICE_TRANSCRIPT_RETENTION_DAYS=90
# See docs/guides/dach-compliance.md for the full data-flow documentation.

# ═══════════════════════════════════════════════
# Sprint 7.5: Signal Messenger
# ═══════════════════════════════════════════════

# ── Signal ───────────────────────────────────
PINCER_SIGNAL_ENABLED=false
# SIGNAL_API_IMAGE=bbernhard/signal-cli-rest-api:latest-dev   # Docker image (default: latest-dev)
# signal-cli-rest-api (inter-container)
PINCER_SIGNAL_API_URL=http://signal-api:8080
# URL for pincer signal pair (host-facing)
PINCER_SIGNAL_PAIR_URL=http://127.0.0.1:8081
# Registered phone (E.164: +1234567890)
PINCER_SIGNAL_PHONE_NUMBER=
# Comma-separated allowed DM numbers; empty = allow all
PINCER_SIGNAL_ALLOWLIST=
# mention_only | all | disabled
PINCER_SIGNAL_GROUP_REPLY=mention_only
# websocket | poll
PINCER_SIGNAL_RECEIVE_MODE=websocket
# Poll interval in seconds (poll mode only)
PINCER_SIGNAL_POLL_INTERVAL=2

# ═══════════════════════════════════════════════
# Slack Channel (Socket Mode)
# ═══════════════════════════════════════════════

# ── Slack Channel ────────────────────────────
# Bot User OAuth Token (from OAuth & Permissions)
# PINCER_SLACK_BOT_TOKEN=xoxb-...
# App-Level Token with scope: connections:write (for Socket Mode)
# PINCER_SLACK_APP_TOKEN=xapp-...
# Comma-separated Slack user IDs allowed to use the bot; empty = allow all
# PINCER_SLACK_USER_ALLOWLIST=

# ═══════════════════════════════════════════════
# Microsoft Teams Channel (inbound HTTP push via Azure Bot)
# ═══════════════════════════════════════════════
# Register an Azure Bot, enable the Teams channel, set the messaging endpoint to
# https://<public-host>/api/messages, and note the App ID + App Password.
# See docs/teams-setup.md for the full walkthrough (incl. ngrok for local dev).
# Azure Bot / App Registration App (client) ID
# PINCER_TEAMS_APP_ID=
# App Registration Tenant ID or 'common' for multitenant app
# PINCER_MS365_TENANT_ID=
# App Password (client secret)
# PINCER_TEAMS_APP_PASSWORD=
# Comma-separated AAD object IDs / UPNs; empty = allow all
# PINCER_TEAMS_USER_ALLOWLIST=

# ═══════════════════════════════════════════════
# Web Chat (browser widget)
# ═══════════════════════════════════════════════

# Optional dedicated bearer token for the chat widget. If unset, the widget
# can authenticate with PINCER_DASHBOARD_TOKEN. If both are unset, the API
# is open (dev/tests only).
# PINCER_WEB_CHAT_TOKEN=

# Origin of the frontend app, added to CORS allow_origins (e.g. https://3days.ai).
# PINCER_WEB_CHAT_URL=

# ═══════════════════════════════════════════════
# MCP Servers section
# ═══════════════════════════════════════════════
# Consumed in pincer toml or docker compose with remap

# Set these before running 'ms365-mcp-setup' to authenticate via device code flow.
# Azure App Application (client) ID
# PINCER_MS365_CLIENT_ID=
# "consumers" for personal accounts, "common", or your org tenant GUID
# PINCER_MS365_TENANT_ID=common
# Reserved (not used by device code flow)
# PINCER_MS365_CLIENT_SECRET=

# NewApi service api key for pincer-mcps.
# PINCER_NEWSAPI_KEY=55d...

# OpenWeatherMap api service key
#PINCER_OPENWEATHERMAP_API_KEY=09a...
